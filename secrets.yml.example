---
# Copy this file to secrets.yml (gitignored) and fill in real values.
# Never commit the real secrets.yml.

# ubuntu/zsh.yml, ubuntu/samba.yml
main_user_account: myuser

# ubuntu/samba.yml (smb_shared-perms.conf)
share_user_account: shareuser

# ubuntu/collectd.yml (collectd.conf, collectd.conf.d/apache.conf, smb_shared-perms.conf)
collectd_hostname: myhost
domain: example.com

# ubuntu/collectd.yml (collectd.conf.d/ping.conf)
collectd_ping_host1: 1.1.1.1
collectd_ping_host2: 8.8.8.8
collectd_ping_host3: 9.9.9.9
collectd_ping_host4: 192.168.1.1
collectd_ping_host5: 192.168.1.254

# ubuntu/pms.yml (snapraid.conf.j2)
pms_parity_mount: /mnt/parity1
pms_data_mounts:
  - name: d1
    mount: /mnt/disk1
  - name: d2
    mount: /mnt/disk2
  - name: d3
    mount: /mnt/disk3

# ubuntu/default.yml, mac/default.yml (slack-notify webhook)
slack_notify_webhook_url: "https://hooks.slack.com/services/<team-id>/<bot-id>/<token>"
