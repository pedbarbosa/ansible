---
# Copy this file to secrets.yml (gitignored) and fill in real values.
# Never commit the real secrets.yml.

# ubuntu/default.yml, openwrt/system.yml (system.conf `zonename`, and
# `timezone` via openwrt_timezone in openwrt/group_vars/all/vars.yml) -
# IANA zone name
timezone: Australia/Brisbane

# ubuntu/zsh.yml, ubuntu/samba.yml
main_user_account: myuser

# ubuntu/samba.yml (smb_shared-perms.conf)
share_user_account: shareuser

# ubuntu/collectd.yml (collectd.conf), ubuntu/samba.yml (smb_shared-perms.conf,
# and the name of the shares' group, gid 1002)
collectd_hostname: myhost

# openwrt/adblock.yml, openwrt/banip.yml (mail sender/receiver),
# openwrt/dhcp.yml (dnsmasq local domain)
domain: example.com

# ubuntu/pms.yml (snapraid.conf.j2), ubuntu/collectd.yml (collectd.conf.d/df.conf)
pms_parity_mount: /mnt/parity1
pms_data_mounts:
  - name: d1
    mount: /mnt/disk1
  - name: d2
    mount: /mnt/disk2
  - name: d3
    mount: /mnt/disk3

# ubuntu/samba.yml (smb.conf `storage`, `music` and `video` shares),
# ubuntu/collectd.yml (collectd.conf.d/df.conf), ubuntu/scripts.yml
# (openwrt-backup.conf.j2, backups go to <storage_mount>/Backups/OpenWRT) -
# main storage mount point
storage_mount: /mnt/pool

# ubuntu/default.yml, mac/default.yml (slack-notify webhook)
slack_notify_webhook_url: "https://hooks.slack.com/services/<team-id>/<bot-id>/<token>"

# mac/zsh.yml (mac/group_vars/all.yml is_corporate)
personal_hostnames:
  - abc
  - def

# openwrt/inventory.yml (router/AP addresses, kept out of the inventory so
# network topology isn't in the public repo). Each AP's "profile" must match
# one of openwrt/group_vars/ap_*.yml - it's how hardware-specific config
# (e.g. system.yml's LEDs) is selected without committing real AP names.
# `host` does double duty as ansible_host *and* the value templated into
# each device's own network.<name>.conf `lan` interface (see
# openwrt/network.yml) - it must match the device's real static LAN IP, not
# just an address ansible happens to reach it on. Each AP's `name` is also
# the ssh hostname ubuntu/scripts.yml writes into ~/.openwrt-backup, so it
# must resolve from the server (DNS or ~/.ssh/config).
openwrt_router_host: 192.168.1.1
openwrt_ap_hosts:
  - name: ap1
    host: 192.168.1.2
    profile: ap_dual_led
  - name: ap2
    host: 192.168.1.3
    profile: ap_wan_led

# openwrt/collectd.yml (collectd.conf) - address of the collectd server
# these devices report to (e.g. the ubuntu host from ubuntu/collectd.yml)
openwrt_collectd_server_host: 192.168.1.4

# openwrt/collectd.yml (collectd.conf) and openwrt/blocklists_mqtt.yml
# (blocklists-mqtt.conf), router only - mosquitto broker and user the router
# publishes to for Home Assistant: collectd metrics, plus adblock/banIP state.
# The user also takes Home Assistant's adblock/banIP on/off commands, so its
# broker ACL needs collectd/#, router/# and homeassistant/+/+/config, plus read
# on homeassistant/status.
openwrt_collectd_mqtt_host: 192.168.1.4
openwrt_collectd_mqtt_user: collectd-router
openwrt_collectd_mqtt_password: <mqtt_password>


# openwrt/collectd.yml (collectd.conf, router only) - ping plugin targets for
# WAN latency/jitter/loss
openwrt_collectd_ping_hosts:
  - 1.1.1.1
  - 8.8.8.8
  - 9.9.9.9
  - 192.168.1.1
  - 192.168.1.254
  - 1.0.0.1

# openwrt/network.yml (network.router.conf) - router's iot VLAN gateway IP;
# the lan IP itself reuses openwrt_router_host above
openwrt_router_iot_host: 192.168.2.1

# openwrt/network.yml (network.router.conf) - WAN PPPoE credentials
openwrt_wan_pppoe_username: <pppoe_username>
openwrt_wan_pppoe_password: <pppoe_password>

# openwrt/network.yml (network.router.conf) - WAN DNS resolvers (peerdns is
# disabled, so these are used verbatim rather than ones handed out by the ISP)
openwrt_wan_dns_servers:
  - 1.1.1.1
  - 1.0.0.1
  - 8.8.8.8
  - 8.8.4.4

# openwrt/wireless.yml (wireless.conf, via openwrt_wifi_ifaces in
# openwrt/group_vars/all/vars.yml) - SSIDs and keys, the same on every device
# with radios. The two SSIDs also serve as the 802.11r NAS IDs
# (openwrt_wifi_nasid). The mobility domain (4 hex digits) must match on every device
# for 802.11r roaming. The country code is a secret for the same reason as
# `timezone` above.
openwrt_wifi_country: AU
openwrt_wifi_lan_ssid: my-wifi
openwrt_wifi_lan_key: <wifi_key>
openwrt_wifi_lan_mobility_domain: "1a2b"
openwrt_wifi_iot_ssid: my-wifi-iot
openwrt_wifi_iot_key: <iot_wifi_key>
