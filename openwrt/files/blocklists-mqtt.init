#!/bin/sh /etc/rc.common
# File managed by Ansible - https://github.com/pedbarbosa/ansible
#
# Reports adblock/banIP to Home Assistant over MQTT and takes its on/off
# commands. See /usr/bin/blocklists-mqtt.

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/blocklists-mqtt

start_service() {
	procd_open_instance state
	procd_set_param command "$PROG" loop
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance commands
	procd_set_param command "$PROG" listen
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

# A clean disconnect doesn't trigger the MQTT will, so say so explicitly.
stop_service() {
	"$PROG" offline
}
