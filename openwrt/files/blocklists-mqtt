#!/bin/sh
# File managed by Ansible - https://github.com/pedbarbosa/ansible
#
# blocklists-mqtt: report adblock and banIP to Home Assistant over MQTT (with
# MQTT discovery, so HA creates the entities itself), and switch them on and
# off from Home Assistant.
#
#   blocklists-mqtt loop     publish discovery, then both services' state every 60s
#   blocklists-mqtt listen   act on ON/OFF commands from Home Assistant
#   blocklists-mqtt state    publish both services' state once
#   blocklists-mqtt offline  mark the router's entities unavailable
#
# Run by /etc/init.d/blocklists-mqtt (procd), one instance each for loop and
# listen.
#
# "Off" is temporary: adblock is suspended (its lists are kept, so resuming is
# quick) and banIP is stopped. A restart, a reboot or the daily cron reload
# can turn either back on.

. /etc/blocklists-mqtt.conf

INTERVAL=60
DISCOVERY_EVERY=60 # republish discovery every hour of loops
BASE=router
DISCOVERY=homeassistant
AVAILABILITY="$BASE/blocklists/availability"
ADB_RT=/var/run/adblock/adblock.runtime.json
BAN_RT=/var/run/banIP/banIP.runtime.json

mqtt_pub() {
	mosquitto_pub -h "$MQTT_HOST" -p "$MQTT_PORT" -u "$MQTT_USER" -P "$MQTT_PASS" "$@"
}

# The runtime files print counts with a space as thousands separator ("341 997").
digits() {
	tr -cd '0-9'
}

# Each read_* sets status (the service's own word), state (ON/OFF) and count.
read_adblock() {
	status=$(jsonfilter -i "$ADB_RT" -e '@.adblock_status' 2>/dev/null)
	count=$(jsonfilter -i "$ADB_RT" -e '@.blocked_domains' 2>/dev/null | digits)
	case "$status" in
		enabled | running) state=ON ;;
		*) state=OFF count=0 ;; # paused, disabled, stopped, error
	esac
}

read_banip() {
	status=$(jsonfilter -i "$BAN_RT" -e '@.status' 2>/dev/null)
	# "260 372 (chains: 7, sets: 16, rules: 45)": the number before the bracket
	count=$(jsonfilter -i "$BAN_RT" -e '@.element_count' 2>/dev/null)
	count=$(printf '%s' "${count%%(*}" | digits)
	case "$status" in
		active | processing) state=ON ;;
		*) state=OFF count=0 ;; # stopped, disabled, error
	esac
}

publish() { # adblock|banip
	"read_$1"
	mqtt_pub -r -t "$BASE/$1/state" \
		-m "{\"state\":\"$state\",\"status\":\"${status:-unknown}\",\"count\":${count:-0}}"
}

publish_all() {
	publish adblock
	publish banip
}

publish_discovery() {
	device='"device":{"identifiers":["openwrt_router"],"name":"Router","manufacturer":"OpenWrt"}'
	avail="\"availability_topic\":\"$AVAILABILITY\""
	for svc in adblock banip; do
		case "$svc" in
			adblock) label=Adblock icon=mdi:advertisements-off unit=domains ;;
			banip) label=banIP icon=mdi:shield-lock unit=IPs ;;
		esac
		# Entity IDs come from "<device> <name>": switch.router_adblock,
		# sensor.router_adblock_blocked, switch.router_banip, sensor.router_banip_blocked
		mqtt_pub -r -t "$DISCOVERY/switch/router_$svc/config" -m "{\"name\":\"$label\",\"unique_id\":\"router_$svc\",\"icon\":\"$icon\",\"state_topic\":\"$BASE/$svc/state\",\"value_template\":\"{{ value_json.state }}\",\"json_attributes_topic\":\"$BASE/$svc/state\",\"command_topic\":\"$BASE/$svc/set\",$avail,$device}"
		mqtt_pub -r -t "$DISCOVERY/sensor/router_${svc}_blocked/config" -m "{\"name\":\"$label blocked\",\"unique_id\":\"router_${svc}_blocked\",\"icon\":\"$icon\",\"state_topic\":\"$BASE/$svc/state\",\"value_template\":\"{{ value_json.count }}\",\"unit_of_measurement\":\"$unit\",\"state_class\":\"measurement\",$avail,$device}"
	done
}

loop() {
	n=0
	while :; do
		[ $((n % DISCOVERY_EVERY)) -eq 0 ] && publish_discovery
		publish_all
		n=$((n + 1))
		sleep "$INTERVAL"
	done
}

# Commands run asynchronously (banIP takes ~35s to load its sets), so keep
# publishing until the service reaches the wanted state, for up to 90s.
publish_until() { # adblock|banip ON|OFF
	i=0
	while [ "$i" -lt 18 ]; do
		sleep 5
		publish "$1"
		[ "$state" = "$2" ] && return
		i=$((i + 1))
	done
}

listen() {
	mqtt_pub -r -t "$AVAILABILITY" -m online
	mosquitto_sub -h "$MQTT_HOST" -p "$MQTT_PORT" -u "$MQTT_USER" -P "$MQTT_PASS" \
		--will-topic "$AVAILABILITY" --will-payload offline --will-retain \
		-v -t "$BASE/adblock/set" -t "$BASE/banip/set" |
		while read -r topic payload; do
			case "$topic $payload" in
				"$BASE/adblock/set ON") /etc/init.d/adblock resume ;;
				"$BASE/adblock/set OFF") /etc/init.d/adblock suspend ;;
				"$BASE/banip/set ON") /etc/init.d/banip start ;;
				"$BASE/banip/set OFF") /etc/init.d/banip stop ;;
				*)
					logger -t blocklists-mqtt "ignoring '$payload' on $topic"
					continue
					;;
			esac
			logger -t blocklists-mqtt "$topic $payload"
			svc=${topic#"$BASE"/}
			publish_until "${svc%/set}" "$payload"
		done
}

case "$1" in
	loop) loop ;;
	listen) listen ;;
	state) publish_all ;;
	offline) mqtt_pub -r -t "$AVAILABILITY" -m offline ;;
	*)
		echo "usage: $0 loop|listen|state|offline" >&2
		exit 1
		;;
esac
