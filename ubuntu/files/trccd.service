# File managed by Ansible - https://github.com/pedbarbosa/ansible
# From trcc-linux's packaging/systemd/trccd.service

[Unit]
Description=TRCC Linux background service
Documentation=https://github.com/Lexonight1/thermalright-trcc-linux

[Service]
Type=simple
ExecStart=/usr/bin/trcc daemon
Restart=on-failure
RestartSec=5
# Lets the daemon start without a graphical session
Environment=QT_QPA_PLATFORM=offscreen

[Install]
WantedBy=default.target
