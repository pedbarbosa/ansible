#!/usr/bin/env bash
#
# Remove the disabled (old) revisions of every installed snap to free disk
# space. Close all snap applications first. Tells Slack only when something
# fails, unless -v is given.

set -uo pipefail

# Installed by the ansible ubuntu playbook; cron's PATH may not include /usr/local/bin
SLACK_NOTIFY=$(command -v slack-notify || echo /usr/local/bin/slack-notify)

usage() {
    cat <<EOF
Usage: $0 [-v] [-h]
  -v    Print each removal, and always send a Slack summary (also when there's nothing to remove)
  -h    Show this help and exit
EOF
}

VERBOSE=false
while getopts "vh" opt; do
    case "$opt" in
        v) VERBOSE=true ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done

log() { if [[ "$VERBOSE" == true ]]; then echo "$*"; fi }

notify() {
    if ! printf '%s\n' "$1" | "$SLACK_NOTIFY"; then
        echo "WARNING: Failed to send the Slack notification" >&2
    fi
}

die() {
    echo "ERROR: $*" >&2
    notify "🚨 snap-clean failed on $(hostname -s): $*"
    exit 1
}

command -v snap >/dev/null 2>&1 || die "snap isn't installed"

# C locale so the Notes column reads "disabled" whatever the system language
if ! LIST=$(LC_ALL=C snap list --all 2>&1); then
    die "snap list failed: $LIST"
fi
OLD_REVISIONS=$(awk 'NR > 1 && /disabled/ {print $1, $3}' <<< "$LIST")

REMOVED=()
FAILURES=()
while read -r name revision; do
    [[ -n "$name" ]] || continue
    log "Removing $name revision $revision..."
    # -n: fail instead of waiting for a password when run from cron
    if output=$(sudo -n snap remove "$name" --revision="$revision" 2>&1); then
        REMOVED+=("$name ($revision)")
    else
        FAILURES+=("$name ($revision): $output")
    fi
done <<< "$OLD_REVISIONS"

if [[ ${#FAILURES[@]} -gt 0 ]]; then
    MESSAGE="snap-clean failed on $(hostname -s):"
    for failure in "${FAILURES[@]}"; do
        MESSAGE+=$'\n'"• $failure"
    done
    if [[ ${#REMOVED[@]} -gt 0 ]]; then
        MESSAGE+=$'\n'"Removed: ${REMOVED[*]}"
    fi
    echo "$MESSAGE" >&2
    notify "🚨 $MESSAGE"
    exit 1
fi

if [[ ${#REMOVED[@]} -gt 0 ]]; then
    MESSAGE="snap-clean on $(hostname -s) removed: ${REMOVED[*]}"
else
    MESSAGE="snap-clean on $(hostname -s): no old snap revisions to remove"
fi
log "$MESSAGE"
if [[ "$VERBOSE" == true ]]; then
    notify "$MESSAGE"
fi
