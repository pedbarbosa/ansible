#!/usr/bin/env bash
#
# Pull the latest images for the server-stack Compose project and recreate the
# containers whose image changed. Tells Slack which containers were
# (re)started, and about any step that failed. Silent when nothing changed,
# unless -v is given.

set -uo pipefail

DC_FILE="$HOME/git/server-stack/docker-compose.yaml"
COMPOSE=(docker compose -f "$DC_FILE" --profile all)

# Installed by the ansible ubuntu playbook; cron's PATH may not include /usr/local/bin
SLACK_NOTIFY=$(command -v slack-notify || echo /usr/local/bin/slack-notify)

usage() {
    cat <<EOF
Usage: $0 [-v] [-h]
  -v    Print progress, and always send a Slack summary (also when nothing changed)
  -h    Show this help and exit
EOF
}

VERBOSE=false
while getopts "vh" opt; do
    case "$opt" in
        v) VERBOSE=true ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done

log() { if [[ "$VERBOSE" == true ]]; then echo "$*"; fi }

ERRORS=""

notify() {
    log "Sending to Slack:"$'\n'"$1"
    if ! printf '%s\n' "$1" | "$SLACK_NOTIFY"; then
        echo "WARNING: Failed to send the Slack notification" >&2
    fi
}

# Record a failed step with the end of its output
add_error() {
    local step=$1 output=$2
    echo "ERROR: $step failed:" >&2
    echo "$output" >&2
    ERRORS+=$'\n'"*$step failed:*"$'\n```\n'"$(printf '%s\n' "$output" | tail -n 20)"$'\n```'
}

if [[ ! -r "$DC_FILE" ]]; then
    add_error "Reading the Compose file" "'$DC_FILE' not found"
    notify "🚨 docker-update-all:$ERRORS"
    exit 1
fi

# A failed pull is reported, but the containers whose images did pull are still updated
log "Pulling images..."
if ! PULL_OUTPUT=$("${COMPOSE[@]}" pull 2>&1); then
    add_error "docker compose pull" "$PULL_OUTPUT"
fi

log "Recreating containers with new images..."
if ! UP_OUTPUT=$("${COMPOSE[@]}" up -d 2>&1); then
    add_error "docker compose up" "$UP_OUTPUT"
fi

# Containers compose recreated, started or restarted. Each one appears on more than one
# status line (e.g. Recreated, then Started), so keep the first of each. Skip the
# <12 hex>_<name> names compose gives old containers while it replaces them.
RESTARTED=$(echo "$UP_OUTPUT" | grep -E "(Recreated|Started|Restarted)" | awk '{print $2}' \
    | grep -v -E "^[a-f0-9]{12}_" | awk '!seen[$0]++')

MESSAGE=""
if [[ -n "$RESTARTED" ]]; then
    MESSAGE="(Re)started containers:"$'\n'"$RESTARTED"
elif [[ "$VERBOSE" == true && -z "$ERRORS" ]]; then
    MESSAGE="docker-update-all: all containers are up to date"
fi
if [[ -n "$ERRORS" ]]; then
    MESSAGE="🚨 docker-update-all:$ERRORS${MESSAGE:+$'\n'$MESSAGE}"
fi
if [[ -n "$MESSAGE" ]]; then
    notify "$MESSAGE"
fi

if [[ -n "$ERRORS" ]]; then
    exit 1
fi
