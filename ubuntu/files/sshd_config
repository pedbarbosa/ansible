# File managed by Ansible - https://github.com/pedbarbosa/ansible

Include /etc/ssh/sshd_config.d/*.conf

ChallengeResponseAuthentication no
UsePAM yes
# Set here rather than by cloud-init's sshd_config.d/50-cloud-init.conf, which
# ubuntu/default.yml removes. sshd keeps the first value it reads, so a file
# in sshd_config.d (included above) would override this line.
PasswordAuthentication yes

X11Forwarding yes
PrintMotd yes

# Hardening
PermitRootLogin no
ClientAliveCountMax 2
Compression no
LogLevel VERBOSE
MaxAuthTries 3
MaxSessions 2

# Allow client to pass locale environment variables
AcceptEnv LANG LC_*

# override default of no subsystems
Subsystem      sftp    /usr/lib/openssh/sftp-server

