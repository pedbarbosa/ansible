#!/usr/bin/env bash
#
# Fast-forward the git checkouts of shell tooling (oh-my-zsh, fzf, pyenv, rbenv
# and their plugins) in the current user's home. Checkouts that don't exist on
# this machine are skipped. Tells Slack only when something fails.
#
# Runs on Ubuntu and macOS, where cron may use /bin/bash 3.2: no associative
# arrays, and guard empty arrays under set -u.

set -uo pipefail

REPOS=(
    "$HOME/.fzf"
    "$HOME/.oh-my-zsh"
    "$HOME/.pyenv"
    "$HOME/.pyenv/plugins/pyenv-virtualenv"
    "$HOME/.rbenv"
    "$HOME/.rbenv/plugins/ruby-build"
)

# Never wait for a credential prompt, and give up on a stalled download
export GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=60

# Installed by the ansible default playbooks; cron's PATH may not include /usr/local/bin
SLACK_NOTIFY=$(command -v slack-notify || echo /usr/local/bin/slack-notify)

usage() {
    cat <<EOF
Usage: $0 [-v] [-h]
  -v    Print each repository and how many commits it pulled
  -h    Show this help and exit
EOF
}

VERBOSE=false
while getopts "vh" opt; do
    case "$opt" in
        v) VERBOSE=true ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

log() { if [[ "$VERBOSE" == true ]]; then echo "$*"; fi }

FAILURES=()

# Record a failure with the last lines of the command's output, without git's hints
add_failure() {
    FAILURES+=("$1: $(printf '%s\n' "$2" | grep -v '^hint:' | tail -n 5)")
}

for repo in "${REPOS[@]}"; do
    name="~/${repo#"$HOME"/}"
    if [[ ! -d "$repo/.git" ]]; then
        log "Skipping $name (not a git checkout)"
        continue
    fi

    before=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
    if ! output=$(git -C "$repo" pull --ff-only --quiet 2>&1); then
        add_failure "$name" "$output"
        continue
    fi
    after=$(git -C "$repo" rev-parse HEAD 2>/dev/null)

    if [[ "$before" == "$after" ]]; then
        log "$name is up to date"
        continue
    fi
    log "$name: pulled $(git -C "$repo" rev-list --count "$before..$after") commit(s)"

    # The fzf binary is downloaded by its install script, not tracked in git
    if [[ "$repo" == "$HOME/.fzf" ]]; then
        if ! output=$("$repo/install" --bin 2>&1); then
            add_failure "$name (install --bin)" "$output"
        fi
    fi
done

if [[ ${#FAILURES[@]} -eq 0 ]]; then
    exit 0
fi

MESSAGE="git-repos-check failed on $(hostname -s):"
for failure in ${FAILURES[@]+"${FAILURES[@]}"}; do
    MESSAGE+=$'\n'"• $failure"
done
echo "$MESSAGE" >&2
if ! printf '🚨 %s\n' "$MESSAGE" | "$SLACK_NOTIFY"; then
    echo "WARNING: Failed to send the Slack notification" >&2
fi
exit 1
